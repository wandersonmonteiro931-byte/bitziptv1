SUPABASE_URL=https://vywtzzrvpdjqpcnixskz.supabase.co

# Chave pública/publishable do Supabase novo:
SUPABASE_ANON_KEY=sb_publishable_sdV_208NVt_5D4Wo8VlJxw_7EX_uIJT
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sdV_208NVt_5D4Wo8VlJxw_7EX_uIJT

# Chave secreta do Supabase novo.
# Cole aqui a sua Secret Key do Supabase.
# Depois que tudo estiver funcionando, o ideal é revogar a secret antiga e criar outra nova.
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SECRET_KEY_DO_SUPABASE
SUPABASE_SECRET_KEY=COLE_AQUI_A_SECRET_KEY_DO_SUPABASE

# Dados da Efí/Gerencianet PIX.
EFI_CLIENT_ID=COLE_AQUI_O_CLIENT_ID_DA_EFI
EFI_CLIENT_SECRET=COLE_AQUI_O_CLIENT_SECRET_DA_EFI
EFI_PIX_KEY=COLE_AQUI_A_CHAVE_PIX_CADASTRADA_NA_EFI

# false = produção / true = homologação
EFI_SANDBOX=false

# Certificado .p12 convertido para Base64.
# Use o arquivo CERTIFICADO_EFI_P12_PARA_BASE64.bat para gerar/copiar.
EFI_CERTIFICATE_BASE64=COLE_AQUI_O_CERTIFICADO_P12_EM_BASE64

# Se o seu certificado .p12 tiver senha, coloque aqui.
# Se não tiver senha, deixe vazio.
EFI_CERTIFICATE_PASSWORD=
